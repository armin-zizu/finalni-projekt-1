rules_version = '2';

// Firebase Storage pravila
service firebase.storage {
  match /b/{bucket}/o {
    // Pravila za invoices (fakture)
    // Korisnik može čitati i pisati samo svoje fakture
    match /users/{userId}/invoices/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: blokiraj sve ostalo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

