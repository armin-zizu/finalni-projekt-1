rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - korisnik može pristupiti samo svojim podacima
    match /users/{userId} {
      // Korisnik može čitati i pisati svoje podatke
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subscription podkolekcija - PRIVREMENO omogućeno za sve autentifikovane korisnike
      match /subscription/{subscriptionId} {
        // Privremeno omogućeno za sve autentifikovane korisnike (debug)
        allow read, write: if request.auth != null;
      }
      
      // Obračuni podkolekcija
      match /obracuni/{obracunId} {
        // Korisnik može čitati i pisati svoje obračune
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
