rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper funkcija za provjeru admin email-a
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email == 'gitara.zizu@gmail.com';
    }
    
    // Users collection - korisnik može pristupiti samo svojim podacima, admin može sve
    match /users/{userId} {
      // Korisnik može čitati i pisati svoje podatke, admin može sve
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Subscription podkolekcija
      match /subscription/{subscriptionId} {
        // Korisnik može čitati i pisati svoju pretplatu, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Obračuni podkolekcija
      match /obracuni/{obracunId} {
        // Korisnik može čitati i pisati svoje obračune, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // Devices collection - korisnik može pristupiti samo svojim uređajima, admin može sve
    match /devices/{deviceId} {
      // Korisnik može čitati svoje uređaje (ako postoji) ili ako je admin
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      
      // Korisnik može kreirati novi uređaj sa svojim userId
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      
      // Korisnik može ažurirati svoje uređaje (mora ostati isti userId)
      allow update: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid && 
         request.resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      
      // Korisnik može brisati svoje uređaje
      allow delete: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
    }
  }
}
