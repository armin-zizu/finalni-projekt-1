rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - korisnik može pristupiti samo svojim podacima
    match /users/{userId} {
      // Korisnik može čitati i pisati svoje podatke
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subscription podkolekcija
      match /subscription/{subscriptionId} {
        // Korisnik može čitati i pisati svoju pretplatu
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Obračuni podkolekcija
      match /obracuni/{obracunId} {
        // Korisnik može čitati i pisati svoje obračune
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Cjenovnik je u users/{userId} dokumentu
      // Već pokriveno gornjim pravilom za users/{userId}
    }
    
    // Fallback pravilo za sve ostalo (trenutno dozvoljeno do 2025-12-15)
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2025, 12, 15);
    }
  }
}
