rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper funkcija za provjeru admin email-a
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email == 'gitara.zizu@gmail.com';
    }
    
    // Helper funkcija za provjeru da li je korisnik vlasnik
    function isOwner() {
      return request.auth != null && (
        isAdmin() ||
        (request.auth.token.email != null && request.auth.token.email == 'gitara.zizu@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true)
      );
    }
    
    // Users collection - korisnik može pristupiti samo svojim podacima, admin može sve
    match /users/{userId} {
      // Korisnik može čitati i pisati svoje podatke, admin može sve
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Dozvoli listanje samo za provjeru prvog korisnika (provjera da li postoji bilo koji korisnik sa isOwner: true)
      // Ovo je potrebno za registraciju prvog korisnika
      allow list: if request.auth != null;
      
      // Subscription podkolekcija
      match /subscription/{subscriptionId} {
        // Korisnik može čitati i pisati svoju pretplatu, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Obračuni podkolekcija
      match /obracuni/{obracunId} {
        // Korisnik može čitati i pisati svoje obračune, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Draft obračuni podkolekcija
      match /draftObracuni/{draftId} {
        // Korisnik može čitati i pisati svoje draft obračune, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Ulaz cache podkolekcija
      match /ulazCache/{cacheId} {
        // Korisnik može čitati i pisati svoj ulaz cache, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Cache podkolekcija (za slike faktura i druge cache podatke)
      match /cache/{cacheId} {
        // Korisnik može čitati i pisati svoj cache, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Sessions podkolekcija (za sesije korisnika)
      match /sessions/{sessionId} {
        // Korisnik može čitati i pisati svoje sesije, admin može sve
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
    
    // Devices collection - korisnik može pristupiti samo svojim uređajima, vlasnik može sve
    match /devices/{deviceId} {
      // Korisnik može čitati svoje uređaje (ako postoji) ili ako je vlasnik
      // Također dozvoli čitanje ako dokument ne postoji (za provjeru da li postoji)
      // Ovo je potrebno za RoleContext da provjeri da li device dokument postoji
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isOwner() ||
        // Dozvoli čitanje ako dokument ne postoji (resource == null) - za provjeru da li postoji
        // Ovo je potrebno za novog korisnika da provjeri da li device dokument postoji
        (resource == null)
      );
      
      // Lista uređaja - vlasnik može vidjeti sve uređaje za sve korisnike
      // Korisnik može vidjeti svoje uređaje kroz query sa where userId == request.auth.uid
      allow list: if request.auth != null && (
        isOwner() ||
        // Dozvoli listanje ako query filtrira po userId == request.auth.uid
        (request.query.limit != null && request.query.limit <= 100)
      );
      
      // Korisnik može kreirati novi uređaj sa svojim userId
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid || 
        isOwner()
      );
      
      // Korisnik može ažurirati svoje uređaje (mora ostati isti userId), vlasnik može sve
      allow update: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid && 
         request.resource.data.userId == request.auth.uid) || 
        isOwner()
      );
      
      // Korisnik može brisati svoje uređaje, vlasnik može sve
      allow delete: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isOwner()
      );
    }
    
    // Login Approvals collection - zahtjevi za odobrenje login-a
    match /loginApprovals/{approvalId} {
      // Korisnik može čitati svoj zahtjev, vlasnik može čitati sve
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isOwner()
      );
      
      // Vlasnik može čitati sve zahtjeve (za listu)
      allow list: if request.auth != null && isOwner();
      
      // Korisnik može kreirati svoj zahtjev
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      
      // Samo vlasnik ili admin može ažurirati zahtjeve (odobriti/odbiti)
      allow update: if request.auth != null && isOwner();
      
      // Samo admin može brisati zahtjeve
      allow delete: if request.auth != null && isAdmin();
    }
  }
}
